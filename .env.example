# LOCAL ONLY: these credentials match compose.yaml; never use them in production.
# Neon: use the pooled (-pooler hostname) URL here, with sslmode=require.
DATABASE_URL=postgresql://roman_poll:local_development_only@localhost:54329/roman_poll
# Neon: use the direct (non-pooler) URL here, with sslmode=require. CLI only.
DIRECT_URL=postgresql://roman_poll:local_development_only@localhost:54329/roman_poll

# Milestone 2: generate a unique secret of at least 32 bytes; no secret defaults.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails; bootstrap is implemented in milestone 2.
ADMIN_EMAILS=

# Milestone 4: server-side sync credentials.
CRON_SECRET=
GAME_API_KEY=
GAME_API_BASE_URL=https://api.collegefootballdata.com

# Milestone 6: origin only, with no path (for example https://example.com).
STATIC_SITE_ORIGIN=
